    "test_outputs": "test_runs/<project_id>/<test|data>/<run_id>"
  },
  "default_project": "demo_steel",
  "models": [
    {"id": "mock", "label": "离线示例 mock（无需 key）", "backend": "mock", "base_url": "(离线，无需网络)", "model": "mock-two-stage"},
    {"id": "claude-4.5-sonnet", "label": "Claude 4.5 Sonnet（多模态）", "backend": "claude", "base_url": "https://api.gpugeek.com/v1/messages", "model": "Vendor2/Claude-4.5-Sonnet"},
